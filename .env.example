# ── Gemini (embeddings + generation fallback) ────────────────────────────────
# Both keys — rename them however you like as long as the name starts with
# GEMINI_API_KEY  (e.g.  GEMINI_API_KEY_1, GEMINI_API_KEY_2, GEMINI_API_KEY)
GEMINI_API_KEY_1=your_first_gemini_key_here
GEMINI_API_KEY_2=your_second_gemini_key_here

# ── Groq (PRIMARY generation — free, fast, generous limits) ──────────────────
# Free key at: https://console.groq.com  (no credit card required)
# Models: LLaMA 3.3 70B, LLaMA 3.1 8B, Mixtral — 1000–14400 req/day free
GROQ_API_KEY=your_groq_key_here

# ── GitHub (optional — higher rate limit when fetching repos) ────────────────
# GITHUB_TOKEN=your_github_token_here

# ── Embedding backend (optional) ──────────────────────────────────────────────
# "gemini" (default) or "local". Set to "local" only after running
# ingest_local.py — it queries a separate, local-model-only collection.
# EMBED_BACKEND=local
